# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Store
STORE_NAME=MyDropShop
STORE_URL=http://localhost:8000
SECRET_KEY=change_this_to_a_random_secret_key

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./dropshipping.db

# Supplier APIs – existing
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
CJDROPSHIPPING_API_KEY=
CJDROPSHIPPING_EMAIL=

# Supplier APIs – new platforms (add keys to activate each)
# DSers: https://www.dsers.com  (Advanced $20/mo — AliExpress order automation)
DSERS_API_KEY=
# Zendrop: https://app.zendrop.com/register  (Plus $49/mo required for API)
ZENDROP_API_KEY=
# Spocket: https://app.spocket.co/register  (Unicorn $99/mo required for API)
SPOCKET_API_KEY=
# AutoDS: https://platform.autods.com/register  ($39-99/mo)
AUTODS_API_KEY=
# Printful: https://www.printful.com/auth/register  (free – Settings > API Access)
PRINTFUL_API_KEY=

# Payment (Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@mydropshop.com

# Web Search (optional - for competitor pricing, product research)
SERP_API_KEY=

# Agent model overrides (defaults shown)
PRODUCT_AGENT_MODEL=claude-opus-4-8
PRICING_AGENT_MODEL=claude-sonnet-4-6
ORDERING_AGENT_MODEL=claude-sonnet-4-6
WEBSITE_AGENT_MODEL=claude-sonnet-4-6
MANAGER_AGENT_MODEL=claude-opus-4-8
