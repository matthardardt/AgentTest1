# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Store
STORE_NAME=Vendo's Deals
STORE_URL=http://localhost:8000
SECRET_KEY=change_this_to_a_random_secret_key

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./dropshipping.db

# Supplier API — AliExpress (product sourcing; orders fulfilled manually)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Payment (Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@vendosdeals.com

# Web Search (optional - for competitor pricing, product research)
SERP_API_KEY=

# Agent model overrides (defaults shown)
PRODUCT_AGENT_MODEL=claude-opus-4-8
PRICING_AGENT_MODEL=claude-sonnet-4-6
ORDERING_AGENT_MODEL=claude-sonnet-4-6
WEBSITE_AGENT_MODEL=claude-sonnet-4-6
MANAGER_AGENT_MODEL=claude-opus-4-8
TRAINING_AGENT_MODEL=claude-opus-4-8
