# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Store
STORE_NAME=MyDropShop
STORE_URL=http://localhost:8000
SECRET_KEY=change_this_to_a_random_secret_key

# Database (default: local SQLite; for Postgres: postgresql+asyncpg://user:pass@host:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///./dropshipping.db

# Supplier APIs
CJDROPSHIPPING_API_KEY=
CJDROPSHIPPING_EMAIL=

# Payment (Stripe)
STRIPE_API_KEY=             # sk_test_... — server-side only, never expose this
STRIPE_PUBLISHABLE_KEY=     # pk_test_... — safe to expose to browser
STRIPE_WEBHOOK_SECRET=      # whsec_... from Stripe → Developers → Webhooks

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@mydropshop.com

# Web Search (optional - for competitor pricing, product research)
SERP_API_KEY=

# Agent model overrides (defaults shown)
PRODUCT_AGENT_MODEL=claude-opus-4-8
PRICING_AGENT_MODEL=claude-sonnet-4-6
ORDERING_AGENT_MODEL=claude-sonnet-4-6
WEBSITE_AGENT_MODEL=claude-sonnet-4-6
MANAGER_AGENT_MODEL=claude-opus-4-8
