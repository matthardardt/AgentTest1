# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Store
STORE_NAME=Vendo's Deals
STORE_URL=https://vendosdeals.com
SECRET_KEY=change_this_to_a_random_secret_key

# Admin API protection (X-API-Key header on /api/admin/*). Defaults to SECRET_KEY.
ADMIN_API_KEY=

# Safety: set to false in production so agents refuse to "ship" orders without
# real supplier credentials instead of returning fake/mock tracking numbers.
ALLOW_MOCK_SUPPLIERS=true

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./dropshipping.db

# Supplier APIs
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
CJDROPSHIPPING_API_KEY=
CJDROPSHIPPING_EMAIL=

# Payment (Stripe)
STRIPE_API_KEY=                 # sk_test_… / sk_live_… (server-side secret)
STRIPE_PUBLISHABLE_KEY=         # pk_test_… / pk_live_… (optional; safe for the browser)
STRIPE_WEBHOOK_SECRET=          # whsec_… from the webhook endpoint you create

# Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@mydropshop.com

# Web Search (optional - for competitor pricing, product research)
SERP_API_KEY=

# Agent model overrides (defaults shown)
PRODUCT_AGENT_MODEL=claude-opus-4-8
PRICING_AGENT_MODEL=claude-sonnet-4-6
ORDERING_AGENT_MODEL=claude-sonnet-4-6
WEBSITE_AGENT_MODEL=claude-sonnet-4-6
MANAGER_AGENT_MODEL=claude-opus-4-8
ANALYSIS_AGENT_MODEL=claude-opus-4-8
